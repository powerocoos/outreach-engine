# Pipeline (local scripts)
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=          # same Google key is fine
ANTHROPIC_API_KEY=
DASHBOARD_URL=              # https://outreach-dashboard.<you>.workers.dev
API_TOKEN=                  # same value as the Worker's API_TOKEN secret

# Business identity, used in every email and export
BRAND_NAME=Ocoos Web Consulting
SENDER_NAME=Xavier
SENDER_TITLE=Founder
BRAND_WEBSITE=https://ocooswebconsulting.com
BRAND_EMAIL=support@ocooswebconsulting.com
BRAND_PHONE=                # callback number shown in the signature
BRAND_ADDRESS=              # physical mailing address (CAN-SPAM requires one)
BOOKING_LINK=               # optional calendar link, signature only
OFFER=free 15-minute website audit
SERVICE_AREA=North Central Florida
SERVICES=website design, website assistance, SEO content writing, digital ad assistance, graphic design and social media assistance
